<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Birthday, Javah ❤️</title>
  <meta name="description" content="A birthday surprise for Javah from Anamika.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --black:#050505; --soft-black:#0b090a; --maroon:#5c0f1b;
      --deep-maroon:#300810; --wine:#7e1d2d; --cream:#f5e9df;
      --muted:#b9a9aa; --line:rgba(177,73,91,.28);
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{background:var(--black);color:var(--cream);font-family:Montserrat,sans-serif;overflow-x:hidden}
    body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:20;background:radial-gradient(circle at 50% 10%,rgba(126,29,45,.10),transparent 35%),radial-gradient(circle at 80% 80%,rgba(92,15,27,.08),transparent 30%)}
    .loader{position:fixed;inset:0;background:#050505;display:grid;place-items:center;z-index:100;transition:opacity 1s,visibility 1s}
    .loader.hide{opacity:0;visibility:hidden}
    .loader-inner{text-align:center}.loader-heart{font-size:42px;animation:pulse 1.2s infinite}
    .loader p{margin-top:15px;letter-spacing:5px;text-transform:uppercase;font-size:10px;color:#a98d90}
    @keyframes pulse{50%{transform:scale(1.18)}}
    .hero{min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;position:relative;padding:40px 20px;overflow:hidden}
    .orb{position:absolute;border-radius:50%;filter:blur(2px);opacity:.35}
    .orb.one{width:360px;height:360px;background:#4a0b17;top:-150px;left:-130px}
    .orb.two{width:420px;height:420px;background:#25060c;right:-200px;bottom:-180px}
    .grain{position:absolute;inset:0;opacity:.05;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E")}
    .hero-content{position:relative;z-index:2;max-width:900px}
    .eyebrow{font-size:11px;letter-spacing:7px;text-transform:uppercase;color:#b35c6c;margin-bottom:28px}
    h1{font-family:"Cormorant Garamond",serif;font-size:clamp(70px,14vw,170px);font-weight:500;line-height:.78;letter-spacing:-5px}
    h1 span{display:block;color:#8d2638;font-style:italic;font-size:.62em;letter-spacing:-1px;margin-top:18px}
    .subtitle{margin:35px auto 0;color:#bcaeb0;max-width:560px;font-size:13px;line-height:2;letter-spacing:1px}
    .scroll{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);font-size:9px;letter-spacing:4px;text-transform:uppercase;color:#735d61}
    .scroll:after{content:"";display:block;width:1px;height:38px;background:linear-gradient(#8d2638,transparent);margin:10px auto 0}
    section{padding:120px 7vw;position:relative}
    .section-label{color:#8d2638;text-transform:uppercase;letter-spacing:5px;font-size:9px;margin-bottom:18px}
    .section-title{font-family:"Cormorant Garamond",serif;font-weight:500;font-size:clamp(42px,6vw,76px);line-height:1}
    .letter-wrap{max-width:820px;margin:55px auto 0;border:1px solid var(--line);background:linear-gradient(135deg,rgba(92,15,27,.12),rgba(255,255,255,.015));padding:clamp(30px,6vw,70px);position:relative}
    .letter-wrap:before,.letter-wrap:after{content:"";position:absolute;width:45px;height:45px;border-color:#7e1d2d;border-style:solid}
    .letter-wrap:before{left:-1px;top:-1px;border-width:1px 0 0 1px}.letter-wrap:after{right:-1px;bottom:-1px;border-width:0 1px 1px 0}
    .letter{font-family:"Cormorant Garamond",serif;font-size:clamp(23px,3vw,32px);line-height:1.65;color:#eadbd4;text-align:center}
    .signature{font-family:"Cormorant Garamond",serif;text-align:right;color:#a94455;font-size:26px;margin-top:30px;font-style:italic}
    .gallery-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:45px}
    .gallery-note{color:#806f72;font-size:10px;letter-spacing:2px;text-transform:uppercase}
    .gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
    .photo{aspect-ratio:4/5;background:linear-gradient(145deg,#1a1113,#3b0b15);border:1px solid rgba(177,73,91,.18);position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center}
    .photo:nth-child(3n){aspect-ratio:1/1.15}.photo:nth-child(5n){aspect-ratio:1/1.3}
    .photo img{width:100%;height:100%;object-fit:cover;display:block}
    .photo .placeholder{font-family:"Cormorant Garamond",serif;color:#9e7b80;font-size:18px;text-align:center;padding:10px}
    .photo .num{position:absolute;left:10px;bottom:9px;color:rgba(255,255,255,.45);font-size:9px;letter-spacing:2px}
    .surprise{text-align:center;background:radial-gradient(circle at center,rgba(92,15,27,.2),transparent 55%)}
    .surprise-card{max-width:680px;margin:45px auto 0}
    button{border:1px solid #792033;background:#19070b;color:#eadbd4;padding:17px 34px;font:500 10px Montserrat,sans-serif;letter-spacing:4px;text-transform:uppercase;cursor:pointer;transition:.3s}
    button:hover{background:#5c0f1b;box-shadow:0 0 35px rgba(126,29,45,.35);transform:translateY(-2px)}
    .hidden-message{max-height:0;overflow:hidden;transition:max-height 1.2s ease;margin-top:0}
    .hidden-message.open{max-height:500px;margin-top:35px}
    .hidden-message p{font-family:"Cormorant Garamond",serif;font-size:clamp(28px,4vw,48px);line-height:1.3;color:#f0ded8}
    .hidden-message small{display:block;color:#92777b;font:10px Montserrat,sans-serif;letter-spacing:3px;text-transform:uppercase;margin-top:18px}
    footer{text-align:center;padding:80px 20px 55px;border-top:1px solid rgba(255,255,255,.05);color:#6d5b5e;font-size:9px;letter-spacing:3px;text-transform:uppercase}
    .heart{color:#8d2638;font-size:18px;margin:10px}
    .floating{position:fixed;bottom:-30px;color:#8d2638;opacity:0;pointer-events:none;z-index:50;animation:floatUp 5s linear forwards}
    @keyframes floatUp{0%{transform:translateY(0) scale(.6);opacity:0}15%{opacity:.8}100%{transform:translateY(-110vh) scale(1.2);opacity:0}}
    @media(max-width:800px){section{padding:90px 6vw}.gallery{grid-template-columns:repeat(2,1fr)}.gallery-head{display:block}.gallery-note{margin-top:15px}.photo{aspect-ratio:3/4!important}}
    @media(max-width:480px){h1{letter-spacing:-2px}.eyebrow{letter-spacing:4px}.gallery{gap:7px}.letter-wrap{padding:30px 22px}}
  </style>
</head>
<body>
  <div class="loader"><div class="loader-inner"><div class="loader-heart">♥</div><p>A little surprise is waiting...</p></div></div>

  <main>
    <section class="hero">
      <div class="orb one"></div><div class="orb two"></div><div class="grain"></div>
      <div class="hero-content">